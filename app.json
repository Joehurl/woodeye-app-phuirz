{
  "expo": {
    "name": "WoodEye",
    "slug": "woodeye",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/26ad3839-d216-4537-8712-0ed9af491b21.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/26ad3839-d216-4537-8712-0ed9af491b21.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/26ad3839-d216-4537-8712-0ed9af491b21.jpeg",
      "supportsTablet": true,
      "bundleIdentifier": "com.woodeye.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "WoodEye uses your camera to photograph wood samples for AI species identification.",
        "NSPhotoLibraryUsageDescription": "WoodEye accesses your photo library so you can select wood photos for AI species identification.",
        "NSPhotoLibraryAddUsageDescription": "WoodEye saves AR wood preview captures to your photo library.",
        "NSLocationWhenInUseUsageDescription": "WoodEye can optionally tag your wood scan location when sharing to the community.",
        "NSUserNotificationsUsageDescription": "WoodEye sends you a daily wood fact notification.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/26ad3839-d216-4537-8712-0ed9af491b21.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.woodeye.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/26ad3839-d216-4537-8712-0ed9af491b21.jpeg",
          "color": "#8B4513"
        }
      ]
    ],
    "scheme": "woodeye",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCatApiKeyAndroid": "REVENUECAT_ANDROID_API_KEY",
      "revenueCatApiKeyIos": "REVENUECAT_IOS_API_KEY",
      "revenueCatEntitlementId": "pro",
      "oneSignalAppId": "4f075e36-8d7b-404f-ae3f-6ab78ed199c6"
    }
  }
}